# Production Environment Configuration
# Copy this to .env for production deployment

# CRITICAL: Change all passwords and secrets!

# Application
ENV=production
APP_ENV=production
DEBUG=False

# Database - PostgreSQL
POSTGRES_USER=kundli_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_DB=kundli_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Security
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://redis:6379/0

# MongoDB (if used)
MONGODB_URL=mongodb://mongodb:27017

# CORS - Add your frontend domain
ALLOWED_ORIGINS=https://yourdomain.com

# Astrological Defaults
DEFAULT_AYANAMSA=lahiri
DEFAULT_HOUSE_SYSTEM=W

# Swiss Ephemeris Path (optional, uses built-in if not set)
# EPHE_PATH=/app/ephemeris

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn_here

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
