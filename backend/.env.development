# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# API
API_V1_STR=/api/v1
PROJECT_NAME="Kundli Calculation Service (Dev)"
VERSION=1.0.0-dev

# CORS (allow localhost)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local)
DATABASE_URL=postgresql://kundli_user:dev_password_123@localhost:5432/kundli_dev
ASYNC_DATABASE_URL=postgresql+asyncpg://kundli_user:dev_password_123@localhost:5432/kundli_dev

# Redis (local)
REDIS_URL=redis://localhost:6379/0

# Security (development keys - NOT for production)
SECRET_KEY=dev_secret_key_not_for_production_use_only
JWT_SECRET=dev_jwt_secret_not_for_production_use_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Swiss Ephemeris
EPHEMERIS_PATH=./ephemeris

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090

# Rate Limiting (relaxed for dev)
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PER_HOUR=10000
