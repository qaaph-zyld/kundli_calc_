# Application Settings
APP_NAME=kundli-calculator
APP_ENV=development
DEBUG=True
API_VERSION=v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kundli_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kundli_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_EXPIRE=3600

# MongoDB Settings (Optional)
MONGODB_URL=mongodb://localhost:27017

# Security Settings
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Swiss Ephemeris Settings
# Path to Swiss Ephemeris data files
# If empty or not set, uses pyswisseph bundled data
EPHE_PATH=/app/ephemeris

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Astrological Defaults
DEFAULT_AYANAMSA=lahiri
DEFAULT_HOUSE_SYSTEM=W
