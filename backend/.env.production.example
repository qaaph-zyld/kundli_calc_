# Application
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# API
API_V1_STR=/api/v1
PROJECT_NAME="Kundli Calculation Service"
VERSION=1.0.0

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
DATABASE_URL=postgresql://kundli_user:CHANGE_ME@postgres:5432/kundli_prod
ASYNC_DATABASE_URL=postgresql+asyncpg://kundli_user:CHANGE_ME@postgres:5432/kundli_prod

# Redis (for caching)
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Swiss Ephemeris
EPHEMERIS_PATH=/app/ephemeris

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
