# Application Settings
APP_NAME=kundli-calculator
APP_ENV=production
ENV=production
DEBUG=False
API_VERSION=v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kundli_db
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/kundli_db

# MongoDB Settings
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=kundli_db

# Redis Settings
REDIS_URL=redis://redis:6379/0

# Security Settings
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000"]

# Swiss Ephemeris Settings
EPHE_PATH=/app/ephemeris

# Astrological Defaults
DEFAULT_AYANAMSA=lahiri
DEFAULT_HOUSE_SYSTEM=W

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
